{
  "name": "@centr-ai/core",
  "version": "0.1.0",
  "description": "Local-first project intelligence, AST indexing, FTS5 search, memory, and token-budgeted context for AI coding agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "author": "CentR Contributors",
  "homepage": "https://chiragpgauswami.github.io/CentR/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiragpgauswami/CentR.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/chiragpgauswami/CentR/issues"
  },
  "keywords": [
    "centr",
    "ai-agents",
    "project-intelligence",
    "context-engine",
    "mcp",
    "memory",
    "sqlite",
    "fts5"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "better-sqlite3": "^13.0.0",
    "glob": "^10.0.0",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0"
  }
}
