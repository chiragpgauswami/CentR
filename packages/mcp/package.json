{
  "name": "@centr/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server for CentR project intelligence",
  "type": "module",
  "bin": {
    "centr-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "author": "CentR Contributors",
  "homepage": "https://chiragpgauswami.github.io/CentR/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiragpgauswami/CentR.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/chiragpgauswami/CentR/issues"
  },
  "keywords": [
    "centr",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "codex",
    "ai-agents"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@centr/brain": "0.1.0",
    "@centr/core": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
