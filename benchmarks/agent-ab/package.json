{
  "name": "@centr-ai/benchmark-ab",
  "version": "0.1.1",
  "description": "Scientific real-agent A/B benchmark harness for CentR",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "centr-benchmark": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "author": "CentR Contributors",
  "homepage": "https://chiragpgauswami.github.io/CentR/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiragpgauswami/CentR.git",
    "directory": "benchmarks/agent-ab"
  },
  "bugs": {
    "url": "https://github.com/chiragpgauswami/CentR/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@centr-ai/core": "0.1.1",
    "@centr-ai/brain": "0.1.1",
    "chalk": "^5.3.0"
  }
}
