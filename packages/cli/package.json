{
  "name": "@centr-ai/cli",
  "version": "0.1.3",
  "description": "Command Line Interface for CentR project intelligence and learning middleware",
  "type": "module",
  "bin": {
    "centr": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "author": "CentR Contributors",
  "homepage": "https://chiragpgauswami.github.io/CentR/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiragpgauswami/CentR.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/chiragpgauswami/CentR/issues"
  },
  "keywords": [
    "centr",
    "cli",
    "ai",
    "coding-agents",
    "context-engine",
    "mcp",
    "project-intelligence",
    "claude-code",
    "codex",
    "cursor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@centr-ai/core": "0.1.3",
    "@centr-ai/brain": "0.1.3",
    "@centr-ai/benchmark-ab": "0.1.3",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ora": "^8.0.0"
  }
}
