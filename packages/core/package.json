{
  "name": "@centr-ai/core",
  "version": "0.1.3",
  "description": "Local-first project intelligence and memory middleware for AI coding agents. AST indexing, SQLite FTS5 code search, project memory, and token-budgeted context engineering.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "author": "CentR Contributors",
  "homepage": "https://chiragpgauswami.github.io/CentR/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiragpgauswami/CentR.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/chiragpgauswami/CentR/issues"
  },
  "keywords": [
    "ai-agents",
    "coding-agents",
    "coding-agent",
    "project-intelligence",
    "code-intelligence",
    "project-memory",
    "agent-memory",
    "context-engineering",
    "context-management",
    "context-retrieval",
    "repository-intelligence",
    "code-search",
    "ast-indexing",
    "token-budget",
    "local-first",
    "local-ai",
    "mcp",
    "developer-tools",
    "sqlite",
    "fts5"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "better-sqlite3": "^13.0.0",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0"
  }
}
