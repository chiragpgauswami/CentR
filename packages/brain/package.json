{
  "name": "@centr/brain",
  "version": "0.1.0",
  "description": "Optional local Small Language Model (SLM) intelligence layer for CentR",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "author": "CentR Contributors",
  "homepage": "https://chiragpgauswami.github.io/CentR/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiragpgauswami/CentR.git",
    "directory": "packages/brain"
  },
  "bugs": {
    "url": "https://github.com/chiragpgauswami/CentR/issues"
  },
  "keywords": [
    "centr",
    "brain",
    "ai-agents",
    "slm",
    "ollama",
    "local-ai",
    "context-ranking"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@centr/core": "0.1.0"
  }
}
